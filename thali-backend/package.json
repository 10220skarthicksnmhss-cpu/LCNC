{
  "name": "thali-backend",
  "version": "1.0.0",
  "description": "Smart AI-Powered Food Subscription Platform — Backend",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/main.js",
    "worker": "tsx watch src/workers/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.53.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.3.0",
    "ioredis": "^5.6.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "twilio": "^5.4.5",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
