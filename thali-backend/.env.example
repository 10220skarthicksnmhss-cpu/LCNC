# Environment — copy to .env and fill in values

# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_BASE_URL=http://localhost:3000

# ── Database (PostgreSQL 18) ────────────────────────────────────────────
DATABASE_URL="postgresql://thali:thali_pass@localhost:5432/thali_db?schema=public"

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_also_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Bcrypt ──────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Notifications ───────────────────────────────────────────────────────
# Firebase FCM (Push)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Nodemailer (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@thali.app

# ── Internal API Key (for ingredient price updates) ─────────────────────
INTERNAL_API_KEY=change_this_to_a_secure_random_key

# ── Platform Settings ───────────────────────────────────────────────────
PLATFORM_COMMISSION_PCT=5
GST_PCT=5
PACKAGING_COST=8
