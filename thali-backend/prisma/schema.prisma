// ============================================================
//  Thali Backend — Prisma Schema
//  DB: PostgreSQL 18
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ────────────────────────────────────────────────────

enum DietaryType {
  VEG
  NON_VEG
  VEGAN
}

enum AutoSwitchPref {
  ALWAYS_ASK
  AI_AUTO_SWITCH
  KEEP_ORIGINAL
}

enum SubStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum AlertStatus {
  PENDING
  USER_KEPT
  USER_SWAPPED
  USER_PICKED_OTHER
  AI_SWITCHED
  TIMED_OUT
  LOCKED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  AUTO_SWITCHED
  LOCKED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum NotifChannel {
  PUSH
  SMS
  EMAIL
  WHATSAPP
}

// ── USERS ────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(15)
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  preferences    UserPreferences?
  addresses      UserAddress[]
  paymentMethods PaymentMethod[]
  refreshTokens  RefreshToken[]
  subscriptions  Subscription[]
  orders         Order[]
  notifications  Notification[]

  @@map("users")
}

model UserPreferences {
  id             String         @id @default(uuid())
  userId         String         @unique @map("user_id")
  dietaryType    DietaryType    @default(VEG) @map("dietary_type")
  cuisines       String[]       @default([])
  allergies      String[]       @default([])
  dailyBudget    Int            @default(150) @map("daily_budget")
  alertThreshold Int            @default(20) @map("alert_threshold")
  autoSwitchPref AutoSwitchPref @default(AI_AUTO_SWITCH) @map("auto_switch_pref")
  notifPush      Boolean        @default(true) @map("notif_push")
  notifSms       Boolean        @default(false) @map("notif_sms")
  notifEmail     Boolean        @default(true) @map("notif_email")
  notifWhatsapp  Boolean        @default(true) @map("notif_whatsapp")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  label       String?  @db.VarChar(50)
  addressLine String   @map("address_line")
  city        String   @db.VarChar(100)
  state       String   @db.VarChar(100)
  pincode     String   @db.VarChar(10)
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  orders        Order[]

  @@map("user_addresses")
}

model PaymentMethod {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  provider      String   @db.VarChar(30)
  maskedNumber  String?  @map("masked_number") @db.VarChar(20)
  cardBrand     String?  @map("card_brand") @db.VarChar(20)
  token         String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ── RESTAURANTS & MEALS ──────────────────────────────────────

model Restaurant {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(200)
  fssaiLicense String?  @map("fssai_license") @db.VarChar(50)
  address      String?
  city         String?  @db.VarChar(100)
  lat          Decimal? @db.Decimal(9, 6)
  lng          Decimal? @db.Decimal(9, 6)
  isActive     Boolean  @default(true) @map("is_active")
  opensAt      String   @default("07:00") @map("opens_at") @db.VarChar(5)
  closesAt     String   @default("22:00") @map("closes_at") @db.VarChar(5)
  marginPct    Decimal  @default(30) @map("margin_pct") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  meals Meal[]

  @@map("restaurants")
}

model Meal {
  id              String      @id @default(uuid())
  restaurantId    String      @map("restaurant_id")
  name            String      @db.VarChar(200)
  cuisine         String      @db.VarChar(100)
  cuisineTag      String?     @map("cuisine_tag") @db.VarChar(50)
  dietaryType     DietaryType @map("dietary_type")
  colorHex        String?     @map("color_hex") @db.VarChar(7)
  deliveryTimeMin Int         @default(30) @map("delivery_time_min")
  basePrice       Decimal     @map("base_price") @db.Decimal(8, 2)
  currentPrice    Decimal     @map("current_price") @db.Decimal(8, 2)
  isAvailable     Boolean     @default(true) @map("is_available")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id])
  recipe              Recipe?
  nutritionalInfo     NutritionalInfo?
  priceHistory        MealPriceHistory[]
  subscriptions       Subscription[]
  orders              Order[]
  alertsOriginal      PriceAlert[]        @relation("OriginalMeal")
  alertsAiSuggested   PriceAlert[]        @relation("AiSuggestedMeal")
  alertsFinal         PriceAlert[]        @relation("FinalMeal")
  aiSuggestions       AiSuggestion[]

  @@map("meals")
}

model NutritionalInfo {
  id        String   @id @default(uuid())
  mealId    String   @unique @map("meal_id")
  calories  Int?
  proteinG  Decimal? @map("protein_g") @db.Decimal(5, 2)
  carbsG    Decimal? @map("carbs_g") @db.Decimal(5, 2)
  fatG      Decimal? @map("fat_g") @db.Decimal(5, 2)
  fiberG    Decimal? @map("fiber_g") @db.Decimal(5, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@map("nutritional_info")
}

model MealPriceHistory {
  id         String   @id @default(uuid())
  mealId     String   @map("meal_id")
  price      Decimal  @db.Decimal(8, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId, recordedAt(sort: Desc)])
  @@map("meal_price_history")
}

// ── INGREDIENTS & RECIPES ────────────────────────────────────

model Ingredient {
  id             String   @id @default(uuid())
  name           String   @unique @db.VarChar(150)
  unit           String   @default("g") @db.VarChar(20)
  currentPrice   Decimal  @map("current_price") @db.Decimal(10, 4)
  lastUpdatedAt  DateTime @default(now()) @map("last_updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  priceHistory       IngredientPriceHistory[]
  recipeIngredients  RecipeIngredient[]
  supplierLinks      IngredientSupplier[]

  @@map("ingredients")
}

model IngredientPriceHistory {
  id            String   @id @default(uuid())
  ingredientId  String   @map("ingredient_id")
  pricePerUnit  Decimal  @map("price_per_unit") @db.Decimal(10, 4)
  source        String?  @db.VarChar(50)
  recordedAt    DateTime @default(now()) @map("recorded_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId, recordedAt(sort: Desc)])
  @@map("ingredient_price_history")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(200)
  contact   String?
  city      String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  ingredientLinks IngredientSupplier[]

  @@map("suppliers")
}

model IngredientSupplier {
  ingredientId String @map("ingredient_id")
  supplierId   String @map("supplier_id")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  supplier   Supplier   @relation(fields: [supplierId], references: [id])

  @@id([ingredientId, supplierId])
  @@map("ingredient_suppliers")
}

model Recipe {
  id        String   @id @default(uuid())
  mealId    String   @unique @map("meal_id")
  serves    Int      @default(1)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meal        Meal               @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id           String   @id @default(uuid())
  recipeId     String   @map("recipe_id")
  ingredientId String   @map("ingredient_id")
  quantity     Decimal  @db.Decimal(8, 3)
  unit         String   @db.VarChar(20)
  pctOfCost    Decimal? @map("pct_of_cost") @db.Decimal(5, 2)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// ── SUBSCRIPTIONS ────────────────────────────────────────────

model Subscription {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  mealId         String         @map("meal_id")
  deliveryTime   String         @map("delivery_time") @db.VarChar(5)
  deliveryDays   Int[]          @default([1, 2, 3, 4, 5, 6, 7]) @map("delivery_days")
  addressId      String?        @map("address_id")
  status         SubStatus      @default(ACTIVE)
  alertThreshold Int            @default(20) @map("alert_threshold")
  autoSwitchPref AutoSwitchPref @default(AI_AUTO_SWITCH) @map("auto_switch_pref")
  budgetLimit    Int?           @map("budget_limit")
  pausedUntil    DateTime?      @map("paused_until")
  cancelledAt    DateTime?      @map("cancelled_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal        Meal         @relation(fields: [mealId], references: [id])
  address     UserAddress? @relation(fields: [addressId], references: [id])
  priceAlerts PriceAlert[]
  orders      Order[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ── PRICE ALERTS ─────────────────────────────────────────────

model PriceAlert {
  id                String      @id @default(uuid())
  subscriptionId    String      @map("subscription_id")
  mealId            String      @map("meal_id")
  originalMealId    String      @map("original_meal_id")
  deliveryDate      DateTime    @map("delivery_date") @db.Date
  oldPrice          Decimal     @map("old_price") @db.Decimal(8, 2)
  newPrice          Decimal     @map("new_price") @db.Decimal(8, 2)
  spikePct          Decimal     @map("spike_pct") @db.Decimal(5, 2)
  spikeReason       String?     @map("spike_reason")
  status            AlertStatus @default(PENDING)
  notifyAt          DateTime    @map("notify_at")
  respondDeadline   DateTime    @map("respond_deadline")
  lockAt            DateTime    @map("lock_at")
  userRespondedAt   DateTime?   @map("user_responded_at")
  aiSuggestedMealId String?     @map("ai_suggested_meal_id")
  finalMealId       String?     @map("final_meal_id")
  finalPrice        Decimal?    @map("final_price") @db.Decimal(8, 2)
  createdAt         DateTime    @default(now()) @map("created_at")

  subscription  Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  meal          Meal           @relation("OriginalMeal", fields: [originalMealId], references: [id])
  aiSuggMeal    Meal?          @relation("AiSuggestedMeal", fields: [aiSuggestedMealId], references: [id])
  finalMeal     Meal?          @relation("FinalMeal", fields: [finalMealId], references: [id])
  aiSuggestions AiSuggestion[]
  orders        Order[]
  notifications Notification[]

  @@index([status])
  @@index([lockAt])
  @@map("price_alerts")
}

model AiSuggestion {
  id         String   @id @default(uuid())
  alertId    String   @map("alert_id")
  mealId     String   @map("meal_id")
  rank       Int
  matchScore Int      @map("match_score")
  reasonJson Json?    @map("reason_json")
  createdAt  DateTime @default(now()) @map("created_at")

  alert PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  meal  Meal       @relation(fields: [mealId], references: [id])

  @@map("ai_suggestions")
}

// ── ORDERS ───────────────────────────────────────────────────

model Order {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  subscriptionId    String?     @map("subscription_id")
  mealId            String      @map("meal_id")
  alertId           String?     @map("alert_id")
  deliveryAddressId String?     @map("delivery_address_id")
  deliveryDate      DateTime    @map("delivery_date") @db.Date
  deliveryTime      String      @map("delivery_time") @db.VarChar(5)
  status            OrderStatus @default(PENDING)
  basePrice         Decimal     @map("base_price") @db.Decimal(8, 2)
  finalPrice        Decimal     @map("final_price") @db.Decimal(8, 2)
  restaurantMargin  Decimal?    @map("restaurant_margin") @db.Decimal(8, 2)
  packagingCost     Decimal?    @map("packaging_cost") @db.Decimal(8, 2)
  gstAmount         Decimal?    @map("gst_amount") @db.Decimal(8, 2)
  platformFee       Decimal?    @map("platform_fee") @db.Decimal(8, 2)
  aiDecision        Boolean     @default(false) @map("ai_decision")
  decisionTrail     String?     @map("decision_trail")
  lockedAt          DateTime?   @map("locked_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id])
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  meal           Meal              @relation(fields: [mealId], references: [id])
  alert          PriceAlert?       @relation(fields: [alertId], references: [id])
  deliveryAddress UserAddress?     @relation(fields: [deliveryAddressId], references: [id])
  statusHistory  OrderStatusHistory[]

  @@index([userId])
  @@index([deliveryDate(sort: Desc)])
  @@index([subscriptionId])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  changedAt DateTime    @default(now()) @map("changed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ── NOTIFICATIONS ────────────────────────────────────────────

model Notification {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  alertId   String?      @map("alert_id")
  orderId   String?      @map("order_id")
  channel   NotifChannel
  title     String
  body      String
  metadata  Json?
  sentAt    DateTime?    @map("sent_at")
  delivered Boolean      @default(false)
  readAt    DateTime?    @map("read_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert PriceAlert? @relation(fields: [alertId], references: [id])

  @@map("notifications")
}

// ── AUDIT LOG ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id")
  action    String   @db.VarChar(50)
  payload   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
